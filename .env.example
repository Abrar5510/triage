# Vultr Serverless Inference (https://my.vultr.com/inference/). Only the orchestrator sees this key;
# sandboxes run with an empty environment.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_URL=https://api.vultrinference.com/v1

# Model IDs from https://api.vultrinference.com/v1/models
TRIAGE_MODEL_FAST=glm-5.3-flash
TRIAGE_MODEL_SMART=glm-5.3
TRIAGE_MODEL_SAFETY=nemotron-3.5-content-safety

# Optional
# TRIAGE_CACHE=~/.cache/triage     # must be bind-mountable by Docker (under $HOME on macOS/colima)
# TRIAGE_DB=./triage.db
# TRIAGE_LIMIT_SECONDS=60
